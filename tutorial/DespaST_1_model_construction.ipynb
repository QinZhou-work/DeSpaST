  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 1.2 Data pre-processing"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 1.2.1 Pre-processing the gene expression matrix"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "(4674, 18085)\n",
      "(4674, 18070)\n"
     ]
    },
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "100%|██████████| 18061/18061 [00:18<00:00, 998.66it/s] \n",
      "100%|██████████| 18061/18061 [00:03<00:00, 5663.46it/s]\n",
      "100%|██████████| 4674/4674 [00:55<00:00, 84.88it/s]\n"
     ]
    }
   ],
   "source": [
    "### Pre-processing the gene expression matrix\n",
    "count = scipy.sparse.csr_matrix.toarray(gene_matrix.X)\n",
    "count = count.T\n",
    "\n",
    "count_df = pd.DataFrame(count.astype(int), columns=genes.loc[:, 1].values, index=barcodes.loc[:, 0].values)\n",
    "\n",
    "# Remove 0s\n",
    "print(count_df.shape)\n",
    "gene_sum = np.sum(count_df, axis=0)\n",
    "gene_names = gene_sum.index.values[gene_sum > 0]\n",
    "count_df = count_df.loc[:, gene_names]\n",
    "print(count_df.shape)\n",
    "\n",
    "# Sum replicate columns\n",
    "from tqdm import tqdm\n",
    "gene_names_unique = []\n",
    "for gene_name in tqdm(list(set(count_df.columns.values))):\n",
    "    if sum([_ == gene_name for _ in count_df.columns.values]) > 1:\n",
    "        # count_df_new.loc[:, gene_name] = np.sum(count_df.loc[:, gene_name], axis=1)\n",
    "        pass\n",
    "    else:\n",
    "        gene_names_unique.append(gene_name)\n",
    "count_df_new = count_df.loc[:, gene_names_unique].copy()\n",
    "for gene_name in tqdm(list(set(count_df.columns.values))):\n",
    "    if gene_name not in gene_names_unique:\n",
    "        count_df_new.loc[:, gene_name] = np.sum(count_df.loc[:, gene_name], axis=1)\n",
    "\n",
    "# CPM normalization\n",
    "count_norm_df = count_df_new.copy().astype(float)\n",
    "for n_row in tqdm(range(len(count_df_new))):\n",
    "    count_norm_df.loc[count_norm_df.index.values[n_row], :] = count_df_new.iloc[n_row, :].values / np.sum(count_df_new.iloc[n_row, :].values)\\\n",
    "                                   * 1000000"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "### Count the stat of the data\n",
    "count_stat = pd.DataFrame(columns=count_norm_df.columns.values, index=[\"mean\", \"std\", \"tile_95\", \"non_zero_p\", \"max\"])\n",
    "count_stat.loc['mean', :] = np.average(count_norm_df, axis=0)\n",
    "count_stat.loc['std', :] = np.std(count_norm_df, axis=0)\n",
    "count_stat.loc['tile_95', :] = np.quantile(count_norm_df, 0.95, axis=0)\n",
    "count_stat.loc['non_zero_p', :] = np.sum(np.array(count_norm_df) > 0, axis=0)/count_norm_df.shape[0]\n",
    "count_stat.loc['max', :] = np.max(count_norm_df, axis=0)\n",
    "\n",
    "### export the output to files\n",
    "count_df_new.to_csv(os.path.join(output_dir, 'count_raw.csv'))\n",
    "count_norm_df.to_csv(os.path.join(output_dir, 'count_norm.csv'))\n",
    "count_stat.to_csv(os.path.join(output_dir, 'count_stat.csv'))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "## Read the counts saved."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "metadata": {},
   "outputs": [],
   "source": [
    "count_df = pd.read_csv(os.path.join(output_dir, 'count_norm.csv'), index_col=0)\n",
    "count_df\n",
    "\n",
    "# Normalize count_df\n",
    "count_stat = pd.read_csv(os.path.join(output_dir, 'count_stat.csv'), index_col=0)\n",
    "count_stat\n",
    "\n",
    "count_max = count_stat.loc['tile_95', :].values\n",
    "count_max[count_max < 1] = 1\n",
    "count_df = count_df/count_max\n"
   ]
  },
